# =============================================================================
# UZU UNION BANK — Environment Variables (Template)
# =============================================================================
# Copy this file to .env and fill in your local development values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Database ---
# SQLite (local development default):
# Local development uses prisma/schema.prisma:
DATABASE_URL="file:./prisma/uzu_bank.db"
# Production uses PostgreSQL with prisma/schema.vercel.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/uzu_bank?schema=public"

# --- Authentication & Security ---
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET="change-this-to-a-random-secret-in-production"

# --- WebSocket ---
WS_PORT=3001
NEXT_PUBLIC_WS_URL="wss://uzu-union-bank.vercel.app"

# --- Application ---
NEXT_PUBLIC_APP_URL="https://uzu-union-bank.vercel.app"
NODE_ENV="development"

# --- SmartSupp Live Chat (optional) ---
# Get your key from https://www.smartsupp.com/ dashboard
NEXT_PUBLIC_SMARTSUPP_KEY=""

# --- Vercel Deployment (set these in Vercel project settings) ---
# Set DATABASE_URL and JWT_SECRET in Production, Preview, and Development.