# =============================================================================
# UZU UNION BANK — Environment Variables (Production Template)
# =============================================================================
# Copy this file to .env and fill in your production values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Database ---
# PostgreSQL (RECOMMENDED for production — use Supabase, Neon, or Railway):
DATABASE_URL="postgresql://user:password@host:5432/uzu_bank?schema=public"
# SQLite (for local development only):
# DATABASE_URL="file:./prisma/uzu_bank.db"

# --- Authentication & Security ---
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET="change-this-to-a-random-secret-in-production"

# --- WebSocket ---
WS_PORT=3001
NEXT_PUBLIC_WS_URL="wss://uzu-union-bank.vercel.app"

# --- Application ---
NEXT_PUBLIC_APP_URL="https://uzu-union-bank.vercel.app"
NODE_ENV="production"

# --- SmartSupp Live Chat (optional) ---
# Get your key from https://www.smartsupp.com/ dashboard
NEXT_PUBLIC_SMARTSUPP_KEY=""

# --- Vercel Deployment (set these in Vercel Dashboard) ---
# DATABASE_URL — Your PostgreSQL connection string
# JWT_SECRET — Your random secret
# NEXT_PUBLIC_APP_URL — Your Vercel domain
# NEXT_PUBLIC_WS_URL — Your Vercel WebSocket URL