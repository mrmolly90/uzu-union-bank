{
  "name": "uzu-union-bank",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate:dev && next dev",
    "build": "npx prisma generate --schema=prisma/schema.vercel.prisma && next build",
    "vercel-build": "npx prisma generate --schema=prisma/schema.vercel.prisma && npx tsx prisma/setup-turso.ts && npx next build",
    "start": "next start",
    "db:generate": "prisma generate --schema=prisma/schema.vercel.prisma",
    "db:generate:dev": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:push:dev": "prisma db push --schema=prisma/schema.prisma",
    "db:setup:turso": "tsx prisma/setup-turso.ts",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "next lint",
    "postinstall": "prisma generate --schema=prisma/schema.vercel.prisma",
    "deploy": "npm run build && npm start"
  },
  "dependencies": {
    "@libsql/client": "^0.8.0",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/three": "^0.187.0",
    "@vercel/blob": "^2.9.0",
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.187.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
