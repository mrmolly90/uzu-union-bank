# =============================================================================
# UZU UNION BANK — .gitignore
# =============================================================================
# This file tells Git which files to ignore. Protects sensitive data and
# keeps the repository clean by excluding build artifacts, dependencies,
# environment files, and IDE/OS clutter.
# =============================================================================

# --- Environment & Secrets (NEVER COMMIT) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
*.pem
*.key
*.crt
!server/.env.example

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Next.js Build Output ---
.next/
out/

# --- Production Build ---
build/
dist/

# --- Database ---
prisma/*.db
prisma/*.db-journal
prisma/migrations/

# --- Server Data Files ---
server/ledger.json
server/users.json
server/data/ledger.json
server/data/users.json
src/server/data/ledger.json
src/server/data/users.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Testing ---
coverage/
.nyc_output/

# --- IDE & Editor ---
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store

# --- OS Files ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Misc ---
*.tgz
.cache/
tmp/
temp/
.vercel
.env*
