{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production",
    "PRISMA_SCHEMA": "prisma/schema.vercel.prisma"
  },
  "crons": [],
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
  "build": {
    "env": {
      "PRISMA_CLIENT_ENGINE_TYPE": "binary"
    }
  }
}